# PYPY Grid Production Environment Configuration
APP_ENV=production
APP_NAME="PYPY Grid"
APP_VERSION=11.9.0
APP_URL=https://pypygrid.com
API_URL=https://api.pypygrid.com
CORS_ORIGINS=https://pypygrid.com,https://app.pypygrid.com

# Database
DATABASE_URL=postgresql://pypy_admin:e09b9b2bb218a671e0a8342a1190753d@postgres:5432/pypy_saas
POSTGRES_DB=pypy_saas
POSTGRES_USER=pypy_admin
POSTGRES_PASSWORD=e09b9b2bb218a671e0a8342a1190753d
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MQTT
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=pypy_admin
MQTT_PASSWORD=e09b9b2bb218a671e0a8342a1190753d

# JWT Security
SECRET_KEY=806b905a4cc812495045daf6ef2953ad3939dc28247470f21268e3876a85d8f1
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Billing
BILLING_PROVIDER=toyyibpay
TOYYIBPAY_USER_SECRET_KEY=mock_toyyibpay_secret
TOYYIBPAY_CATEGORY_CODE=MOCK_CAT
TOYYIBPAY_SANDBOX=true

# SMTP Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=noreply@pypygrid.com
SMTP_PASSWORD=production_gmail_app_password

# AI & OpenAI
OPENAI_API_KEY=sk-mock-openai-key-for-prod
OPENAI_MODEL=gpt-4o
AI_COPILOT_MAX_TOKENS=4096

# Added to satisfy V11.9 GA testing parameters
SENDGRID_API_KEY=mock_key_for_testing
