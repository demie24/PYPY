# ================================================================
# PYPY Grid — Production Environment Configuration
# V11.9 Commercial Launch
# ================================================================
# SECURITY: Never commit real secrets to version control.
# Copy this file to .env.production and fill in actual values.
# ================================================================

# ── Application ─────────────────────────────────────────────────
APP_ENV=production
APP_NAME="PYPY Grid"
APP_VERSION=11.9.0
APP_URL=https://pypygrid.com
API_URL=https://api.pypygrid.com
CORS_ORIGINS=https://pypygrid.com,https://app.pypygrid.com

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pypygrid_prod:CHANGE_ME@db:5432/pypygrid_prod
POSTGRES_DB=pypygrid_prod
POSTGRES_USER=pypygrid_prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/2
CELERY_CONCURRENCY=8
CELERY_MAX_TASKS_PER_CHILD=1000

# ── MQTT ─────────────────────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USERNAME=pypygrid_prod
MQTT_PASSWORD=CHANGE_ME
MQTT_TLS_ENABLED=true
MQTT_CA_CERT=/etc/mqtt/certs/ca.crt

# ── Billing ──────────────────────────────────────────────────────
# Options: toyyibpay | stripe | manual
BILLING_PROVIDER=toyyibpay

# ToyyibPay (Malaysia)
TOYYIBPAY_USER_SECRET_KEY=CHANGE_ME
TOYYIBPAY_CATEGORY_CODE=CHANGE_ME
TOYYIBPAY_SANDBOX=false

# Stripe (International)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ACADEMIC_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_ACADEMIC_YEARLY=price_CHANGE_ME
STRIPE_PRICE_RESEARCH_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_RESEARCH_YEARLY=price_CHANGE_ME

# ── Email (SMTP) ─────────────────────────────────────────────────
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=noreply@pypygrid.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_NAME="PYPY Grid"
EMAIL_FROM_ADDRESS=noreply@pypygrid.com
EMAIL_SUPPORT=support@pypygrid.com
EMAIL_BILLING=billing@pypygrid.com
EMAIL_ADMIN=admin@pypygrid.com

# ── AI / OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o
AI_COPILOT_MAX_TOKENS=4096
AI_RATE_LIMIT_FREE=5
AI_RATE_LIMIT_ACADEMIC=500
AI_RATE_LIMIT_RESEARCH_LAB=-1
AI_RATE_LIMIT_ENTERPRISE=-1

# ── Storage ──────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=/data/pypy_storage
# For S3-compatible storage (MinIO / AWS S3):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_BUCKET=pypygrid-prod

# ── Backup ───────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_PATH=/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_ENCRYPTION_KEY=CHANGE_ME_aes256_key

# ── Monitoring ───────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0

# ── Blockchain ───────────────────────────────────────────────────
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK_ID=pypygrid-main-1
BLOCKCHAIN_PEER_NODES=peer1.pypygrid.com:5000,peer2.pypygrid.com:5000,peer3.pypygrid.com:5000

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_IP=20
RATE_LIMIT_API_FREE=100
RATE_LIMIT_API_ACADEMIC=1000
RATE_LIMIT_API_RESEARCH_LAB=10000

# ── Feature Flags ────────────────────────────────────────────────
FEATURE_AI_COPILOT=true
FEATURE_MARKETPLACE=true
FEATURE_BLOCKCHAIN=true
FEATURE_RESEARCH_WORKSPACE=true
FEATURE_MULTI_TENANT=true
FEATURE_ADMIN_PORTAL=true
FEATURE_ANALYTICS=true
FEATURE_BACKUP=true
FEATURE_MAINTENANCE_MODE=false

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/pypygrid

# ── Plan Limits ──────────────────────────────────────────────────
PLAN_FREE_SIMULATIONS=5
PLAN_FREE_SCENARIOS=5
PLAN_ACADEMIC_SIMULATIONS=-1
PLAN_ACADEMIC_AI_PROMPTS=500
PLAN_RESEARCH_SIMULATIONS=-1
PLAN_RESEARCH_AI_PROMPTS=-1
PLAN_RESEARCH_API_CALLS_PER_DAY=10000

# ── Admin ────────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@pypygrid.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SSL / TLS ────────────────────────────────────────────────────
SSL_CERT_PATH=/etc/ssl/certs/pypygrid.crt
SSL_KEY_PATH=/etc/ssl/private/pypygrid.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt
HSTS_MAX_AGE=31536000
