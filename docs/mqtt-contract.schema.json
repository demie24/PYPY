{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pypy.local/schemas/mqtt-contract.schema.json",
  "title": "PYPY verified MQTT defense contract",
  "type": "object",
  "$defs": {
    "telemetry": {
      "type": "object",
      "required": ["timestamp", "grid_name", "solver_status", "state"],
      "properties": {
        "timestamp": {"type": "number"},
        "grid_name": {"const": "ieee39"},
        "solver_status": {"$ref": "#/$defs/solverStatus"},
        "state": {
          "type": "object",
          "required": ["buses", "lines", "breakers"]
        }
      }
    },
    "solverStatus": {
      "type": "object",
      "required": ["converged", "mode", "iterations"],
      "properties": {
        "converged": {"type": "boolean"},
        "mode": {"enum": ["converged", "fallback_decoupled", "failed"]},
        "iterations": {"type": "integer", "minimum": 0}
      }
    },
    "alert": {
      "type": "object",
      "required": ["timestamp", "type", "severity", "suspect_node"],
      "properties": {
        "timestamp": {"type": "number"},
        "type": {"type": "string"},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "suspect_node": {"type": "string"}
      }
    },
    "threat": {
      "type": "object",
      "required": ["timestamp", "threat_score", "severity"],
      "properties": {
        "timestamp": {"type": "number"},
        "threat_score": {"type": "number", "minimum": 0, "maximum": 100},
        "severity": {"type": "string"}
      }
    },
    "controlProposal": {
      "type": "object",
      "required": ["command", "target", "source"],
      "properties": {
        "command": {"enum": ["OPEN", "CLOSE", "CLOSED"]},
        "target": {"type": "string"},
        "source": {"enum": ["L6_RECOVERY_PARTIAL", "L6_RECOVERY_FULL"]}
      }
    },
    "orchestratorEvent": {
      "type": "object",
      "required": ["timestamp", "event", "command", "target", "reason"],
      "properties": {
        "event": {"enum": ["APPROVAL", "REJECTION"]},
        "command": {"type": "string"},
        "target": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "control": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"type": "string"},
        "target": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "gridEvent": {
      "type": "object",
      "required": ["timestamp", "source", "event", "severity"]
    },
    "modelInference": {
      "type": "object",
      "required": ["timestamp", "source_telemetry_timestamp", "component", "model_loaded", "checkpoint", "inference_latency_ms"],
      "properties": {
        "timestamp": {"type": "number"},
        "source_telemetry_timestamp": {"type": "number"},
        "component": {"enum": ["lstm", "gnn", "stgnn", "pinn"]},
        "model_loaded": {"const": true},
        "checkpoint": {"type": "string"},
        "inference_latency_ms": {"type": "number", "minimum": 0}
      }
    },
    "modelStatus": {
      "type": "object",
      "required": ["timestamp", "component", "ready", "model_loaded", "inference_count", "last_error"],
      "properties": {
        "component": {"enum": ["lstm", "gnn", "stgnn", "pinn", "fusion", "trust"]},
        "ready": {"type": "boolean"},
        "model_loaded": {"type": "boolean"},
        "inference_count": {"type": "integer", "minimum": 0}
      }
    },
    "aiFusion": {
      "type": "object",
      "required": ["timestamp", "component", "calibrated", "fused_risk", "confidence", "component_evidence", "baselines"],
      "properties": {
        "component": {"const": "fusion"},
        "calibrated": {"const": true},
        "fused_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "trustScores": {
      "type": "object",
      "required": ["bus_trust", "line_trust", "details"]
    }
  },
  "x-topic-map": {
    "pypy/grid/telemetry": "#/$defs/telemetry",
    "grid/alerts": "#/$defs/alert",
    "grid/threat": "#/$defs/threat",
    "grid/control/proposed": "#/$defs/controlProposal",
    "grid/orchestrator/events": "#/$defs/orchestratorEvent",
    "grid/control": "#/$defs/control",
    "grid/events": "#/$defs/gridEvent",
    "grid/ai/lstm": "#/$defs/modelInference",
    "grid/ai/gnn": "#/$defs/modelInference",
    "grid/ai/stgnn": "#/$defs/modelInference",
    "grid/ai/pinn": "#/$defs/modelInference",
    "grid/ai/fusion": "#/$defs/aiFusion",
    "grid/trust_scores": "#/$defs/trustScores",
    "grid/ai/status/lstm": "#/$defs/modelStatus",
    "grid/ai/status/gnn": "#/$defs/modelStatus",
    "grid/ai/status/stgnn": "#/$defs/modelStatus",
    "grid/ai/status/pinn": "#/$defs/modelStatus",
    "grid/ai/status/fusion": "#/$defs/modelStatus",
    "grid/ai/status/trust": "#/$defs/modelStatus"
  }
}
